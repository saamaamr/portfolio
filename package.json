{
  "name": "abdullah-al-mamun-portfolio",
  "version": "2.0.0",
  "description": "Technical Support Engineer portfolio for Abdullah Al Mamun, built with Node.js, Express, EJS, and JavaScript.",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --delay 2.5 server.js",
    "dev:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "dev:server": "nodemon --delay 2.5 server.js",
    "vercel-build": "npm run build:css",
    "generate-pdf": "node scripts/generate-pdf.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "portfolio",
    "express",
    "node",
    "personal website"
  ],
  "author": "Abdullah Al Mamun",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.9",
    "email-validator": "^2.0.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.1.0",
    "nodemailer": "^10.5.0",
    "winston": "^3.11.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.1",
    "puppeteer-core": "^25.17.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4"
  }
}
