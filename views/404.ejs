<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <a href="#main-content" id="skip-to-content" class="skip-link">Skip to content</a>
    <main id="main-content" class="min-h-screen flex items-center justify-center px-4">
      <section class="card max-w-xl p-8 text-center" aria-labelledby="not-found-title">
        <p class="gradient-text font-semibold mb-3">Error 404</p>
        <h1 id="not-found-title" class="text-4xl font-bold mb-4">Page Not Found</h1>
        <p class="text-secondary mb-8">The page you requested does not exist or may have moved.</p>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full gradient-bg text-white font-medium">
          <i class="fas fa-arrow-left" aria-hidden="true"></i> Return home
        </a>
      </section>
    </main>
  </body>
</html>
