<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= t('meta.description') %>" />
  <meta name="author" content="Abdullah Al Mamun" />
  <meta name="robots" content="<%= typeof metaRobots !== 'undefined' ? metaRobots : 'index, follow' %>" />
  <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= canonicalUrl || 'https://mamunsandwipi.vercel.app/' %>" />
  <meta property="og:title" content="<%= t('meta.title') %>" />
  <meta property="og:description" content="<%= t('meta.socialDescription') %>" />
  <meta property="og:image" content="https://mamunsandwipi.vercel.app/assets/social-card.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="<%= lang.replace('-', '_') %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= t('meta.title') %>" />
  <meta name="twitter:description" content="<%= t('meta.socialDescription') %>" />
  <meta name="twitter:image" content="https://mamunsandwipi.vercel.app/assets/social-card.png" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : t('meta.title') %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <% if (canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>" /><% } %>
  <% alternateLinks.forEach((link) => { %><link rel="alternate" hreflang="<%= link.hreflang %>" href="<%= link.href %>" /><% }) %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="/js/theme-init.js"></script>
  <link rel="stylesheet" href="/css/output.css" />
  <% if (typeof includeStructuredData === 'undefined' || includeStructuredData) { %>
    <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Abdullah Al Mamun',
      jobTitle: t('hero.title'),
      description: t('meta.structuredDescription'),
      url: canonicalUrl,
      email: 'mailto:mamun872381cpi@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Sandwip', addressRegion: 'Chattogram', addressCountry: 'BD' },
      sameAs: ['https://github.com/saamaamr', 'https://www.linkedin.com/in/abdullah-a-699a90117/', 'https://www.facebook.com/saamaamr1']
    }).replace(/</g, '\\u003c') %></script>
  <% } %>
  <script id="locale-data" type="application/json" nonce="<%= cspNonce %>"><%- serializedClientMessages %></script>
  <script defer src="/js/script.js"></script>
  <script defer src="/js/gradient-mesh.js"></script>
</head>
